discovery.docker "expense_tracker" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "expense_tracker" {
  targets = discovery.docker.expense_tracker.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "expense_tracker" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.expense_tracker.output

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}